# ===========================================
# THE GRYD - Frontend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# API CONFIGURATION
# ===========================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:8083/api

# ===========================================
# DEFAULT USER (Development Only)
# Remove in production - use proper authentication
# ===========================================
EXPO_PUBLIC_USER_ID=
EXPO_PUBLIC_USER_ROLE=agent
EXPO_PUBLIC_TENANT_ID=

# ===========================================
# AGORA (Voice/Video Calls)
# Must match backend AGORA_APP_ID
# ===========================================
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id

# ===========================================
# CLOUDINARY (Direct Upload - Optional)
# For client-side uploads, only need cloud name
# ===========================================
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ===========================================
# FIREBASE (Push Notifications - Optional)
# For web push notifications
# ===========================================
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
