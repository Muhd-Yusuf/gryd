# ===========================================
# THE GRYD - Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=8083
NODE_ENV=development

# ===========================================
# DATABASE
# ===========================================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# ===========================================
# CORS ORIGINS
# Comma-separated list of allowed origins
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# EMAIL SERVICE (Choose one)
# ===========================================

# Option 1: Brevo (Sendinblue) - RECOMMENDED
BREVO_API_KEY=your-brevo-api-key

# Option 2: SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Option 3: Custom SMTP
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=your-smtp-username
EMAIL_SMTP_PASS=your-smtp-password

# Email sender info
EMAIL_FROM_ADDRESS=noreply@the-gryd.com
EMAIL_FROM_NAME=The GRYD

# ===========================================
# FILE UPLOAD - CLOUDINARY (Primary)
# Get credentials at: https://cloudinary.com/console
# ===========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# FILE UPLOAD - AWS S3 (Fallback)
# ===========================================
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ===========================================
# VOICE/VIDEO CALLS - AGORA
# Get credentials at: https://console.agora.io
# ===========================================
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# ===========================================
# PUSH NOTIFICATIONS - FIREBASE (Optional)
# Get credentials at: https://console.firebase.google.com
# ===========================================
# Option 1: Service account JSON (base64 encoded or raw JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 2: Individual credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===========================================
# PUBLIC APP URL
# Used for generating invite links, etc.
# ===========================================
PUBLIC_APP_URL=http://localhost:8081

# ===========================================
# FEATURE FLAGS
# Comma-separated list of enabled features
# ===========================================
ENABLED_FEATURES=community,properties,crm,calendar,agents,billing,admin
